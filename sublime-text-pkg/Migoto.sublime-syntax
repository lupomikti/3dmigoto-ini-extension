%YAML 1.2
---
name: Migoto
file_extensions:
  - ini
  - 3dm
  - migoto
scope: source.migoto
version: 2
variables:
  cl_section_names: \s*(?:(?:(?:Shader|Texture)Override).+(?=\s*\])|Clear(?:RenderTarget|DepthStencil)View|ClearUnorderedAccessView(?:Uint|Float))
  cl2_section_names: \s*(?:Present|(?:BuiltIn)?(?:CustomShader|CommandList).+(?=\s*\]))
  kvp_section_names: \s*(?:(?:Resource|Key|Preset).+(?=\s*\])|Include.*(?=\s*\])|Hunting|Input|Logging|System|Device|Stereo|Rendering|Profile|ConvergenceMap|Loader)
  special_section_names: \s*(?:Constants|(?:Pool|ShaderRegex).+(?=\s*\]))
  ws: "[ \\t]"
  namespace_path: '[^\s>\\|\/<?:*="$][^>\\|\/<?:*=$\r\n]+(?:[\\\/][^>\\|\/<?:*=$\r\n]+)*'
  namespace: "[^=$&>|<\\r\\n]+"
  custom_section_name: "[^=$,\\r\\n]+"
  var: "[a-z_]\\w+|[a-z]"
  ident: "[a-z0-9]\\w+"
  line_end_context: (?:\n|(?<=\n))
  path_keys: (?:override|cache|storage)_directory|include(?:_recursive)?|exclude_recursive
  keybinding_keys: >2
      key | back |
      (?:done_|toggle_)hunting | next_marking_mode | mark_snapshot |
      (?:previous|next|mark)_(?:pixel|vertex|compute|geometry|domain|hull)shader |
      (?:previous|next|mark)_(?:index|vertex)buffer | (?:previous|next)_(?:index|vertex)buffer_slot |
      (?:previous|next|mark)_rendertarget|
      take_screenshot | reload_fixes | (?:reload|wipe_user)_config | show_original |
      monitor_performance | freeze_performance_monitor | tune[123]_(?:up|down) |
      analyse_frame | toggle_full_screen | force_full_screen_on_key | toggle_input
  instructions: |2
      run|checktextureoverride|(?:exclude_)?preset|handling|clear|special|dump|store|
      draw(?:indexed|instanced|indexedinstanced|instancedindirect|indexedinstancedindirect)?|dispatch(?:indirect)?
  resource_copy_targets: |2
      [vgdhpcsturfibo\-\d_]+\b|
      this\b|(?:ini|stereo)params\b|cursor_(?:mask|color)\b|
      (?:Resource|Pool)[^=\r\n]+
  resource_copy_targets_non_slot: |2
      (?:vb\d|ib|(?:[rf]_)?bb|s?o\d|od)\b|
      this\b|(?:ini|stereo)params\b|cursor_(?:mask|color)\b|
      (?:Resource|Pool)[^=\r\n]+
contexts:
  main:
    - include: comment
    - include: preamble
    - include: section-base
  resource-type:
    - meta_scope: meta.enum-value.directx
    - scope: entity.name.type.resource.migoto
      match: \b(?i)((?:RW)?(?:Append|Consume)?StructuredBuffer|(?:RW)?(?:ByteAddress)?Buffer|(?:RW)?Texture[123]D|TextureCube)\b
    - include: dxgi-format
  fallthrough:
    - match: (?=\[(?:{{cl_section_names}}|{{kvp_section_names}}|{{special_section_names}}|{{cl2_section_names}})\])
      pop: 2
  comment:
    - match: ^({{ws}}*)((;)<([^\n]*)\n)
      captures:
        "0": comment.line.semicolon.migoto
        "1": punctuation.whitespace.comment.leading.migoto
        "2": punctuation.definition.comment-fold.begin.migoto
        "3": punctuation.definition.comment.migoto
        "4": comment.line.semicolon.content.migoto
    - match: ^({{ws}}*)(;).*(>)(?=\n)
      captures:
        "1": punctuation.whitespace.comment.leading.migoto
        "2": punctuation.definition.comment.migoto
        "3": punctuation.definition.comment-fold.end.migoto
      push:
        - meta_scope: comment.line.semicolon.migoto
        - meta_content_scope: comment.line.semicolon.content.migoto
        - match: \n
          pop: true
    - match: ^({{ws}}*)(;;!)
      captures:
        "1": punctuation.whitespace.comment.leading.migoto
        "2": punctuation.definition.comment.migoto
      push:
        - meta_scope: comment.line.documentation.migoto
        - meta_content_scope: comment.line.documentation.content.migoto
        - match: \n
          pop: true
    - match: ^({{ws}}+)?(;)(?!;!)
      captures:
        "1": punctuation.whitespace.comment.leading.migoto
        "2": punctuation.definition.comment.migoto
      push:
        - meta_scope: comment.line.semicolon.migoto
        - meta_content_scope: comment.line.semicolon.content.migoto
        - match: \n
          pop: true
    - match: ^\S+{{ws}}*(;)
      captures:
        "1": invalid.illegal punctuation.definition.comment.migoto
      push:
        - meta_scope: invalid.illegal comment.line.semicolon.migoto
        - match: \n
          pop: true
  preamble:
    - match: (?i)^{{ws}}*(namespace)\b{{ws}}*(=){{ws}}*
      captures:
        "1": meta.fixed-value.key keyword.other.migoto
        "2": punctuation.separator.key-value.migoto
      push:
        - meta_scope: meta.head.namespace.migoto
        - match: (?i)\b{{namespace_path}}
          scope: entity.name.namespace.migoto
          pop: true
        - match: \n
          pop: true
    - match: (?i)^{{ws}}*(condition)\b{{ws}}*(=){{ws}}*\b
      captures:
        "1": meta.fixed-value.key keyword.other.migoto
        "2": keyword.operator.assignment.migoto
      push:
        - meta_scope: meta.head.include-condition.migoto
        - include: static-operational-expr
        - match: \n
          pop: true
  section-base:
    - match: \[
      scope: punctuation.definition.entity.begin.migoto
      push: section-title
  section-title:
    - meta_scope: meta.tag.section-header.migoto
    - match: (?i){{ws}}*Constants
      scope: meta.section.constants.migoto entity.name.constructor.migoto
      push:
        - match: \]
          scope: punctuation.definition.entity.end.migoto
          pop: 2
          set: section-body
        - match: \n
          pop: true
    - match: (?i){{ws}}*Pool.+(?=\s*\])
      scope: meta.section.pool.migoto entity.name.section.group-title.migoto
      push:
        - match: \]
          scope: punctuation.definition.entity.end.migoto
          pop: 2
          set: pool-body
        - match: \n
          pop: true
    - match: (?i){{ws}}*ShaderRegex.+\.Pattern(?=\s*\])
      scope: meta.section.shader-regex.pattern.migoto
        entity.name.section.group-title.migoto
      push:
        - match: \]
          scope: punctuation.definition.entity.end.migoto
          pop: 2
          push:
            - meta_content_scope: meta.embedded.block.regexp
            - include: comment
            - match: (?=\[\s*(?:{{cl_section_names}}|{{kvp_section_names}}|{{special_section_names}})\s*\])
              pop: true
            - include: scope:source.regexp.pcre2
        - match: \n
          pop: true
    - match: (?i){{ws}}*ShaderRegex.+\.Pattern\.Replace(?=\s*\])
      scope: meta.section.shader-regex.replace.migoto
        entity.name.section.group-title.migoto
      push:
        - match: \]
          scope: punctuation.definition.entity.end.migoto
          pop: 2
          push:
            - meta_content_scope: meta.embedded.block.regexp-replace
            - include: comment
            - match: (?=\[\s*(?:{{cl_section_names}}|{{kvp_section_names}}|{{special_section_names}})\s*\])
              pop: true
            - include: scope:source.regexp-replace.pcre2
        - match: \n
          pop: true
    - match: (?i){{ws}}*ShaderRegex.+\.InsertDeclarations(?=\s*\])
      scope: meta.section.shader-regex.declarations.migoto
        entity.name.section.group-title.migoto
      push:
        - match: \]
          scope: punctuation.definition.entity.end.migoto
          pop: 2
          set: regex-declarations-body
        - match: \n
          pop: true
    - match: (?i){{ws}}*ShaderRegex.+(?!\.(?:Pattern(\.Replace)?|InsertDeclarations))(?=\s*\])
      scope: meta.section.shader-regex.migoto entity.name.section.group-title.migoto
      push:
        - match: \]
          scope: punctuation.definition.entity.end.migoto
          pop: 2
          set: regex-commandlist-body
        - match: \n
          pop: true
    - match: (?i){{ws}}*{{kvp_section_names}}
      scope: meta.section.settings.migoto entity.name.section.group-title.migoto
      push:
        - match: \]
          scope: punctuation.definition.entity.end.migoto
          pop: 2
          set: section-body
        - match: \n
          pop: true
    - match: (?i){{ws}}*{{cl_section_names}}
      scope: meta.section.commandlists.migoto entity.name.class.migoto
      push:
        - match: \]
          scope: punctuation.definition.entity.end.migoto
          pop: 2
          set: section-body
        - match: \n
          pop: true
    - match: (?i){{ws}}*{{cl2_section_names}}
      scope: meta.section.commandlists.migoto entity.name.function.migoto
      push:
        - match: \]
          scope: punctuation.definition.entity.end.migoto
          pop: 2
          set: section-body
        - match: \n
          pop: true
  pool-body:
    - include: comment
    - match: (?xi) ^{{ws}}* (?= pool_\w+\b \s* = \s* [^\r\n]+ )
      push:
        - meta_scope: meta.statement.setting.migoto
        - include: key
        - match: =
          scope: punctuation.separator.key-value.migoto
          push:
            - include: static-operational-expr
            - include: resource-type
            - include: boolean-value
            - include: string
            - include: path-value
            - include: blend-expr
            - include: fuzzy-match-expr
            - include: fixed-value-opt
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
    - include: setting-statement
    - include: fallthrough
  regex-declarations-body:
    - include: comment
    - include: fallthrough
  regex-commandlist-body:
    - include: comment
    - include: shader-regex-setting-statement
    - include: primary-statement
    - include: fallthrough
  shader-regex-setting-statement:
    - match: (?i)\b(filter_index)\b
      scope: meta.keyword.key keyword.other.migoto
      push:
        - meta_scope: meta.statement.setting.migoto
        - match: =
          scope: punctuation.separator.key-value.migoto
          push:
            - include: constant
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
    - match: (?i)\b(shader_model|temps)\b
      scope: meta.keyword.key keyword.other.migoto
      push:
        - meta_scope: meta.statement.setting.migoto
        - match: =
          scope: punctuation.separator.key-value.migoto
          push:
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
  section-body:
    - include: setting-statement
    - include: global-declaration
    - include: primary-statement
    - include: comment
    - include: fallthrough
  setting-statement:
    - match: |
        (?xi)
        ^{{ws}}*
        (?=
          \bhash\b
          \s* = \s*
          [a-z0-9]+
        )
      push:
        - meta_scope: meta.statement.setting.migoto
        - match: (?i)\b(hash)\b
          scope: meta.keyword.hash.key keyword.other.migoto
        - match: =
          scope: punctuation.separator.key-value.migoto
          push:
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
    - match: |
        (?xi)
        ^{{ws}}*
        (?=
          \b[vhdgpc]s\b
          \s* = \s*
          [^\r\n]+
        )
      push:
        - meta_scope: meta.statement.setting.migoto
        - match: (?i)\b([vhdgpc]s)\b
          scope: meta.keyword.shader.key keyword.other.migoto
        - match: =
          scope: punctuation.separator.key-value.migoto
          push:
            - match: (?i)\b(null)\b
              scope: constant.language.null.migoto
            - include: path-value
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
    - match: |
        (?xi)
        ^{{ws}}*
        (?=
          \b({{keybinding_keys}})\b
          \s* = \s*
          [^\r\n]+
        )
      push:
        - meta_scope: meta.statement.setting.migoto
        - match: (?xi)\b({{keybinding_keys}})
          scope: meta.keyword.binding.key keyword.other.migoto
        - match: =
          scope: punctuation.separator.key-value.migoto
          push:
            - include: keybinding-modifier
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
    - match: |
        (?xi)
        ^{{ws}}*
        (?=
          \b (?:blend | alpha) (?:\[\d+\])? \b
          \s* = \s*
          [^\r\n]+
        )
      push:
        - meta_scope: meta.statement.setting.migoto
        - scope: meta.keyword.blend-state.key keyword.other.migoto
          match: "(?xi)\\b(?: (?: blend | alpha ) (?: \\[ (\\d+) \\] )? )"
          captures:
            "1": constant.numeric.migoto
        - match: =
          scope: punctuation.separator.key-value.migoto
          push:
            - include: blend-expr
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
    - match: |
        (?xi)
        ^{{ws}}*
        (?=
          \b({{path_keys}})\b
          \s* = \s*
          [^\r\n]+
        )
      push:
        - meta_scope: meta.statement.setting.migoto
        - match: (?i)\b{{path_keys}}
          scope: meta.keyword.path-value.key keyword.other.migoto
        - match: =
          scope: punctuation.separator.key-value.migoto
          push:
            - include: path-value
            - match: "{{ws}}*(.+?){{ws}}*$"
              captures:
                "1": constant.other.path.migoto
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
    - match: |
        (?xi)
        ^{{ws}}*
        (?!\b(?:
          hash | [vhdgpc]s | [xyzw]\d{0,3} |
          (?:blend | alpha)(?:\[\d+\])? |
          {{path_keys}} | {{keybinding_keys}} |
          {{instructions}} | {{resource_copy_targets_non_slot}}
        )\b)
        (?= [\w\[\]]+ \s* = \s* [^\r\n]+ )
      push:
        - meta_scope: meta.statement.setting.migoto
        - include: key
        - match: =
          scope: punctuation.separator.key-value.migoto
          push:
            - include: static-operational-expr
            - include: resource-type
            - include: boolean-value
            - include: string
            - include: path-value
            - include: fuzzy-match-expr
            - include: fixed-value-opt
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
  primary-statement:
    - include: local-declaration
    - include: general-statement
    - include: conditional-statement
  conditional-statement:
    - match: (?i)^{{ws}}*(if|elif|else if)(?= )
      captures:
        "1": keyword.control.flow.migoto
      push:
        - meta_scope: meta.statement.conditional.migoto
        - meta_content_scope: meta.expression.operational.migoto
        - include: operational-expr
        - match: "{{line_end_context}}"
          pop: true
    - match: (?i)^{{ws}}*(else|endif){{ws}}*$
      captures:
        "1": keyword.control.flow.migoto
      push:
        - meta_scope: meta.statement.conditional.migoto
        - match: "{{line_end_context}}"
          pop: true
  global-declaration:
    - match: |-
        (?xi)
        (?=
          (?: \b (?:persist|locked) \s+)?
          \b global \s+
          (?: \b (?:persist|locked) \s+)?
        \s*
          (?:
            = \s*
            [^\r\n]+
          )?
        )
      push:
        - meta_scope: meta.statement.declaration.global.migoto
        - match: (?i)\b(global|persist|locked)\b
          scope: storage.modifier.migoto
        - include: named-variable
        - match: =
          scope: keyword.operator.assignment.migoto
          push:
            - include: static-operational-expr
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
  local-declaration:
    - match: |-
        (?xi)
        (?=
          \b local \s+
          \$\w+ \b
        \s*
          (?:
            = \s*
            [^\r\n]+
          )?
        )
      push:
        - meta_scope: meta.statement.declaration.local.migoto
        - match: (?i)\b(local)\b
          scope: storage.modifier.migoto
        - include: named-variable
        - match: =
          scope: keyword.operator.assignment.migoto
          push:
            - include: operational-expr
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
  general-statement:
    - include: assignment-statement
    - include: instruction-statement
  assignment-statement:
    - match: |-
        (?xi)
        ^{{ws}}*
        (?=
          (?: (?:pre|post) \s+)?
          (?: \$ [^=\r\n]+ | \b[xyzw]\d{0,3}\b )
          \s* = \s*
          [^\r\n]+
        )
      push:
        - meta_scope: meta.statement.assignment.migoto
        - match: (?i)\b(pre|post)\b
          scope: meta.command-list.priority keyword.control.directive.migoto
        - include: ini-parameter
        - include: scalar-variable
        - match: =
          scope: keyword.operator.assignment.migoto
          push:
            - include: operational-expr
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
    - match: |-
        (?xi)
        ^{{ws}}*
        (?=
          (?: (?:pre|post) \s+)?
          commandlist[^=\r\n]+\b
          \s* = \s*
          [^\r\n]+
        )
      push:
        - meta_scope: meta.statement.assignment.migoto
        - match: (?i)\b(pre|post)\b
          scope: meta.command-list.priority keyword.control.directive.migoto
        - include: callable-commandlist
        - match: =
          scope: keyword.operator.assignment.migoto
          push:
            - match: (?i)\bref(?:erence)?\b
              scope: meta.keyword.proxy-modifier keyword.other.functional.migoto
            - include: callable-commandlist
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
    - match: |-
        (?xi)
        ^{{ws}}*
        (?=
          (?: (?:pre|post) \s+)?
          [^\r\n]+ -> \w+\( .+ \)
          \s* = \s*
          [^\r\n]+
        )
      push:
        - meta_scope: meta.statement.assignment.migoto
        - match: (?i)\b(pre|post)\b
          scope: meta.command-list.priority keyword.control.directive.migoto
        - include: resource-property-method-call
        - match: =
          scope: keyword.operator.assignment.migoto
          push:
            - include: operational-expr
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
    - match: |-
        (?xi)
        ^{{ws}}*
        (?=
          (?: (?:pre|post) \s+)?
          \b(
            [vgdhpcsturfibo\-\d_]+\b |
            this\b | (?:ini|stereo)params\b | cursor_(?:mask|color)\b |
            (?: Resource | Pool ) [^=\r\n]+
          )
          \s* = \s*
          [^\r\n]+
        )
      push:
        - meta_scope: meta.statement.assignment.migoto
        - match: (?i)\b(pre|post)\b
          scope: meta.command-list.priority keyword.control.directive.migoto
        - include: resource
        - include: resource-pool-base
        - match: =
          scope: keyword.operator.assignment.migoto
          push:
            - include: resource-usage-expr
            - match: "{{line_end_context}}"
              pop: true
        - match: "{{line_end_context}}"
          pop: true
  instruction-statement:
    - match: |-
        (?xi)
        {{ws}}*
        (?=
          (?:
            (?: (?:pre|post) \s+)?
            \b\w+\b
            \s* = \s*
            [^\r\n]+
          ) |
          drawauto
        )
      push:
        - meta_scope: meta.statement.instruction.migoto
        - match: (?i)\b(pre|post)\b
          scope: meta.command-list.priority keyword.control.directive.migoto
        - match: (?xi)(?= \b (?!(?:exclude_)?preset) \w+ \b \s* = \s* [^\r\n]+)
          push:
            - meta_scope: meta.function-call.instruction
            - match: (?xi)\b({{instructions}})\b
              scope: keyword.other.instruction.migoto
            - match: =
              scope: keyword.operator.execution.migoto
              push:
                - include: operational-expr
                - include: callable-commandlist
                - include: callable-customshader
                - include: fixed-value
                - match: "{{line_end_context}}"
                  pop: true
            - match: "{{line_end_context}}"
              pop: true
        - match: (?xi)(?= \b (?:exclude_)?preset \b \s* = \s* [^\r\n]+)
          push:
            - meta_scope: meta.preset-instruction
            - match: (?i)\b((?:exclude_)?preset)\b
              scope: meta.function-call.instruction keyword.other.instruction.migoto
            - match: =
              scope: keyword.operator.execution.migoto
              push:
                - match: (?xi)(?= (?:Preset (?:\\.+\\)? )? [^=$,\r\n]+ )
                  push:
                    - meta_scope: variable.other.function.migoto
                    - match: (?i)\b(Preset)
                      scope: entity.name.function.section-type.migoto
                    - match: (?=\\)
                      push:
                        - include: namespace
                    - include: section-identifier
                    - match: "{{line_end_context}}"
                      pop: true
                - match: "{{line_end_context}}"
                  pop: true
            - match: "{{line_end_context}}"
              pop: true
        - match: (?i){{ws}}*\b(drawauto)\b
          scope: meta.drawauto-instruction
          captures:
            "1": meta.function-call.instruction keyword.other.instruction.migoto
        - match: "{{line_end_context}}"
          pop: true
  blend-expr:
    - match: |
        (?xi)
        (?= \b (?: (\w+) \s+ (\w+) \s+ (\w+) | disable) )
      push:
        - meta_scope: meta.expression.blend-state.migoto
        - match: (?i)\b(add|(?:rev_)?subtract|min|max|disable)\b
          scope: meta.keyword.blend-operator keyword.operator.migoto
        - match: \b(?i)(zero|one|(?:inv_)?(?:src1?|dest)_(?:color|alpha)|src_alpha_sat|(?:inv_)?blend_factor)\b
          scope: meta.keyword.blend-factor keyword.other.migoto
        - match: "{{line_end_context}}"
          pop: true
  fuzzy-match-expr:
    - scope: meta.expression.fuzzy-match.migoto
      match: |
        (?xi)
        (?:
          ([><]=?|[!=]) \s* \b (\d+) \b | # an integer w/ operator
          ([><]=?|[!=])? # optional operator
          \s*
          (?:
            \b ((?:res_)?(?:width|height)|depth|array) \b # field name
            \s*
            (?:
              (?:(\*)\s*\b((?:res_)?(?:width|height)|depth|array)\b) |
              (?:(\*)\s*\b(\d+)\b)? # integer multiplicand
              \s*
              (?:(/)\s*\b(\d+)\b)? # integer divisor
            )
          ) # field expression
        )
        \s*$
      captures:
        "1": keyword.operator.comparison.migoto
        "2": constant.numeric.migoto
